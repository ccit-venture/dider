# Driver database: "sqlite" (default) atau "supabase"
DB_DRIVER=sqlite

# --- SQLite (default) ---
DB_FILE=data/app.db

# --- Supabase (aktif saat DB_DRIVER=supabase) ---
# 1. bun add @supabase/supabase-js
# 2. isi nilai di bawah & apply migrasi supabase/migrations/001_init.sql di Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
